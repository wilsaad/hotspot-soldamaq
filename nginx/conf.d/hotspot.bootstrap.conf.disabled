# Use este arquivo temporariamente antes de emitir o certificado.
# Depois do certbot, renomeie para .disabled e use hotspot.conf.
server {
  listen 80;
  server_name _;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    proxy_pass http://portal-app:3000;
    include /etc/nginx/snippets/proxy-headers.conf;
  }
}

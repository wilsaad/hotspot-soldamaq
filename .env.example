# Dominios e timezone
PUBLIC_HOST=hotspot.exemplo.com.br
N8N_HOST=hotspot.exemplo.com.br
TZ=America/Campo_Grande

# Portal
NODE_ENV=production
PORT=3000
SESSION_SECRET=troque-por-um-segredo-longo
COOKIE_SECURE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_MAX=5
GUEST_MINUTES=480
TEMP_GUEST_MINUTES=7
EXTENDED_GUEST_MINUTES=120
VALIDATION_LINK_TTL_SECONDS=1800
DEFAULT_STORE_ID=1
POST_LOGIN_MESSAGE_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# PostgreSQL compartilhado por portal, n8n e Evolution
POSTGRES_DB=hotspot
POSTGRES_USER=hotspot
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://hotspot:troque-esta-senha@postgres:5432/hotspot
N8N_POSTGRES_DB=hotspot
EVOLUTION_POSTGRES_DB=hotspot

# Redis
REDIS_URL=redis://redis:6379/0

# UniFi Network Application
UNIFI_BASE_URL=https://unifi.seudominio.local:8443
UNIFI_USERNAME=hotspot-api
UNIFI_PASSWORD=troque-esta-senha
UNIFI_DEFAULT_SITE=default
UNIFI_VERIFY_TLS=false
# auto tenta /proxy/network primeiro e cai para /api se necessario.
UNIFI_API_MODE=auto

# MikroTik HotSpot (usuarios locais criados pelo script RouterOS)
MIKROTIK_ENTRY_USERNAME=soldamaq7
MIKROTIK_ENTRY_PASSWORD=troque-esta-senha
MIKROTIK_EXTENDED_USERNAME=soldamaq120
MIKROTIK_EXTENDED_PASSWORD=troque-esta-senha

# n8n
N8N_ENCRYPTION_KEY=troque-por-32-caracteres-ou-mais
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-esta-senha
N8N_WEBHOOK_SEND_OTP_URL=http://n8n:5678/n8n/webhook/hotspot-send-otp
N8N_WEBHOOK_POST_LOGIN_URL=http://n8n:5678/n8n/webhook/hotspot-post-login
N8N_SHARED_SECRET=troque-por-um-token-entre-portal-e-n8n

# Evolution API
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE=hotspot
EVOLUTION_BASE_URL=http://evolution-api:8080

# Perfil para a VM OCI existente:
# - n8n ja roda em /srv/n8n no container automation_n8n
# - Nginx ja roda no container automation_nginx
# - Evolution API ja roda em /srv/evolution no container evolution_nocsaad

NODE_ENV=production
PORT=3000
SESSION_SECRET=troque-por-um-segredo-longo
COOKIE_SECURE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_MAX=5
GUEST_MINUTES=480
TEMP_GUEST_MINUTES=7
EXTENDED_GUEST_MINUTES=120
VALIDATION_LINK_TTL_SECONDS=1800
DEFAULT_STORE_ID=1
POST_LOGIN_MESSAGE_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

POSTGRES_DB=hotspot
POSTGRES_USER=hotspot
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://hotspot:troque-esta-senha@hotspot-postgres:5432/hotspot

REDIS_URL=redis://hotspot-redis:6379/0

UNIFI_BASE_URL=https://unifi.seudominio.local:8443
UNIFI_USERNAME=hotspot-api
UNIFI_PASSWORD=troque-esta-senha
UNIFI_DEFAULT_SITE=default
UNIFI_VERIFY_TLS=false
UNIFI_API_MODE=auto

# n8n existente na rede Docker automation_net.
N8N_WEBHOOK_SEND_OTP_URL=http://automation_n8n:5678/webhook/hotspotSendOtp01/webhook/hotspot-send-otp
N8N_WEBHOOK_POST_LOGIN_URL=http://automation_n8n:5678/webhook/hotspot-post-login
N8N_SHARED_SECRET=troque-por-um-token-entre-portal-e-n8n

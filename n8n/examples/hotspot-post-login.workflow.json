{
  "name": "Hotspot - Mensagem Pos Login",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hotspot-post-login",
        "responseMode": "responseNode"
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.EVOLUTION_BASE_URL}}/message/sendText/{{$env.EVOLUTION_INSTANCE}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.EVOLUTION_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"number\":\"{{$json.body.telefone}}\",\"text\":\"Obrigado pela visita! Avalie nossa loja: https://search.google.com/local/writereview?placeid={{$json.body.google_place_id}}\"}"
      },
      "id": "EvolutionSendText",
      "name": "Evolution - Send Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true}"
      },
      "id": "Respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Evolution - Send Text", "type": "main", "index": 0 }]]
    },
    "Evolution - Send Text": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  }
}
